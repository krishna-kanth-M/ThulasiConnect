# ==============================================================================
# ThulasiConnect Environment Configuration Template
# Copy this file to `.env` for local development and replace all placeholders.
# NEVER commit `.env` or real credentials to version control.
# ==============================================================================

# --- Application ---
APP_NAME=ThulasiConnect
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_HEX_KEY
JWT_SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_JWT_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Backend API (FastAPI / Uvicorn) ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Frontend (Vite / React) ---
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WS_BASE_URL=ws://127.0.0.1:8000

# --- Database (PostgreSQL 16) ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=thulasiconnect_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_DB_PASSWORD
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/thulasiconnect_dev

# --- Local LLM Service (Ollama) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_REQUEST_TIMEOUT_SECONDS=45

# --- Local Speech-to-Text (Faster-Whisper, CPU INT8, In-Memory Only) ---
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4
WHISPER_BEAM_SIZE=3
WHISPER_VAD_FILTER=true
WHISPER_DOWNLOAD_ROOT=ai-services/models
HF_HUB_DISABLE_SYMLINKS_WARNING=1
# Audio persistence is strictly prohibited; audio chunks are processed in memory only.
AUDIO_STORAGE_ENABLED=false

# --- Escalation Timing Defaults (Configurable via Administration UI) ---
ESCALATION_BRANCH_MANAGER_OVERDUE_MINUTES=60
ESCALATION_ZONAL_MANAGER_OVERDUE_MINUTES=240
ESCALATION_OWNER_OVERDUE_MINUTES=1440

# --- Initial Development Admin Bootstrap (used ONLY by bootstrap_admin CLI) ---
# Set temporarily when running `python -m app.cli.bootstrap_admin`
# BOOTSTRAP_ADMIN_EMAIL=admin@thulasipharmacy.local
# BOOTSTRAP_ADMIN_PASSWORD=REPLACE_BEFORE_BOOTSTRAP
