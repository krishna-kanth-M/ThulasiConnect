# ==============================================================================
# ThulasiConnect Cloud Production Environment Variables Template
# ==============================================================================
# Instructions:
# 1. Fill these environment variables in your hosting provider's dashboard (e.g. Render Web Service).
# 2. DO NOT commit this file with production values to version control.
# ==============================================================================

# --- Application Configuration ---
APP_NAME=ThulasiConnect
APP_ENV=production
APP_DEBUG=false

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_KEY
JWT_SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_KEY
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Server & CORS Configuration ---
# In cloud Docker containers, bind to 0.0.0.0 and PORT supplied by provider (Render sets $PORT dynamically)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated list of allowed frontend origins (NO trailing slashes)
CORS_ALLOWED_ORIGINS=https://thulasiconnect.vercel.app,https://thulasiconnect-krishna-kanth-m.vercel.app

# --- Managed PostgreSQL 16 Database Configuration ---
# Supports standard postgres:// or postgresql+psycopg:// URLs
# Example: postgresql+psycopg://thulasi_user:password@ep-proj-1234.us-east-2.aws.neon.tech/thulasiconnect_prod?sslmode=require
DATABASE_URL=REPLACE_WITH_PRODUCTION_DATABASE_CONNECTION_STRING

# --- Audio Privacy & Speech-to-Text (STT) Invariants ---
# STRICT INVARIANT: Audio recording persistence is prohibited. All audio frames are processed in-memory and discarded.
AUDIO_STORAGE_ENABLED=false

# Faster-Whisper CPU INT8 in-memory configuration
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=2
WHISPER_BEAM_SIZE=3
WHISPER_VAD_FILTER=true
WHISPER_DOWNLOAD_ROOT=/app/ai-services/models
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# --- AI Prescription Extraction ---
# In cloud container environments without local GPU, backend uses built-in deterministic regex fallback when OLLAMA_BASE_URL is empty.
# Leave EMPTY by default in cloud production to avoid network timeouts to localhost.
# Set only if connecting to an external dedicated Ollama or OpenAI-compatible gateway endpoint:
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_REQUEST_TIMEOUT_SECONDS=45

# --- Escalation Scheduling Engine ---
# Minutes overdue before triggering role-based escalation alerts
ESCALATION_BRANCH_MANAGER_OVERDUE_MINUTES=60
ESCALATION_ZONAL_MANAGER_OVERDUE_MINUTES=240
ESCALATION_OWNER_OVERDUE_MINUTES=1440

# --- Frontend Vercel Environment Variables (Configure in Vercel Project Settings) ---
# VITE_API_BASE_URL=https://thulasiconnect-backend.onrender.com
# VITE_WS_BASE_URL=wss://thulasiconnect-backend.onrender.com
